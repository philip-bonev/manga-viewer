{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manga Viewer",
  "version": "1.0.0",
  "identifier": "com.philip-bonev.manga-viewer",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Manga Viewer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "Comic Book ZIP Archive",
        "ext": [
          "cbz"
        ],
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/x-cbz"
      },
      {
        "name": "Comic Book TAR Archive",
        "ext": [
          "cbt"
        ],
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/x-cbt"
      },
      {
        "name": "Comic Book 7z Archive",
        "ext": [
          "cb7"
        ],
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/x-cb7"
      }
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libjavascriptcoregtk-4.1-0"
        ],
        "files": {
          "/usr/share/mime/packages/com.philip-bonev.manga-viewer.xml": "mime/comicbook-mime.xml"
        },
        "postInstallScript": "scripts/postinst",
        "preRemoveScript": "scripts/prerm"
      }
    }
  }
}
