{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manga Viewer",
  "version": "0.2.0",
  "identifier": "com.philip-bonev.manga-viewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Manga Viewer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "Comic Book ZIP Archive",
        "ext": ["cbz"],
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/vnd.comicbook+zip",
        "exportedType": {
          "identifier": "com.philip-bonev.manga-viewer",
          "conformsTo": ["public.zip-archive"]
        }
      },
      {
        "name": "Comic Book TAR Archive",
        "ext": ["cbt"],
        "role": "Viewer",
        "mimeType": "application/x-tar"
      },
      {
        "name": "Comic Book 7z Archive",
        "ext": ["cb7"],
        "role": "Viewer",
        "mimeType": "application/x-7z-compressed"
      },
      {
        "name": "EPUB Book",
        "ext": ["epub"],
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/epub+zip"
      }
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": null,
      "appimage": null
    }
  }
}