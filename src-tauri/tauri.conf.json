{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manga Viewer",
  "version": "0.2.0",
  "identifier": "com.philip-bonev.manga-viewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Manga Viewer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "Manga Viewer Document",
        "ext": [
          "cbz",
          "epub"
        ],
        "role": "Viewer",
        "rank": "Owner"
      }
    ]
  }
}